# ── LLM ───────────────────────────────────────────────────────────────────
# Provider: any OpenAI-compatible API (Ollama, DeepSeek, vLLM, etc.)
# For Ollama (local): key is ignored, use "ollama"
# For DeepSeek cloud: set your API key
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b

# Example for DeepSeek:
# LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash

# Controls response randomness. 0.0 = deterministic (always same answer for same input).
# Higher values (e.g. 0.7) produce more varied, creative responses.
# LLM_TEMPERATURE=0.0
# Maximum tokens the model is allowed to generate per response.
# LLM_MAX_TOKENS=4096
# Sets how many tokens the model can see at once (Ollama num_ctx). If the total prompt
# (system + history + retrieved context) exceeds this value, it will be truncated and
# the generated answer may be empty or incomplete. Cloud providers ignore this setting.
# LLM_CONTEXT_LENGTH=8192
# Disable chain-of-thought thinking tokens for models that support them (Qwen, DeepSeek-R1, etc.).
# Set to "false" to free token budget for the actual response. Default: true.
# LLM_THINK_ENABLE=true
# Hard cap for answer tokens. Use this to reserve context space and avoid empty answers
# when the retrieved context and history are large.
# LLM_COMPLETION_MAX_TOKENS=768
# Max reranked chunks promoted to the final answer prompt.
# LLM_CONTEXT_MAX_CHUNKS=4
# If the first answer returns empty, retry with only this many top chunks.
# LLM_CONTEXT_RETRY_MAX_CHUNKS=2
# Per-chunk character cap before assembling the final RAG prompt.
# LLM_CHUNK_MAX_CHARS=1600
# Total character budget shared by all retrieved chunks in the final answer prompt.
# LLM_CONTEXT_CHARS_BUDGET=9000

# ── Embeddings ───────────────────────────────────────────────────────────
# Backend: "sentence_transformer" (local, default) or "ollama" (HTTP API)
# EMBEDDING_BACKEND=sentence_transformer
# HuggingFace model ID used when EMBEDDING_BACKEND=sentence_transformer.
# EMBEDDING_MODEL=BAAI/bge-m3
# Device for local embedding inference: "cpu", "cuda", or "mps".
# EMBEDDING_DEVICE=cpu

# When EMBEDDING_BACKEND=ollama:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Reduces CUDA memory fragmentation on GPUs with < 8 GB VRAM
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ── Chunking & Ingestion ─────────────────────────────────────────────────
# Tokens per text chunk. Smaller = more precise retrieval, larger = more context per chunk.
# CHUNK_SIZE=512
# Token overlap between adjacent chunks to avoid splitting in the middle of a sentence.
# CHUNK_OVERLAP=128
# How many documents to process per ingestion batch. 0 = process all in one batch.
# INGEST_BATCH_SIZE=0
# How many chunks to embed per batch. 0 = auto-detect based on GPU memory.
# EMBEDDING_BATCH_SIZE=0

# ── Retrieval ────────────────────────────────────────────────────────────
# Max chunks fetched by vector similarity (cosine) search.
# SIMILARITY_TOP_K=20
# Max chunks fetched by keyword-based BM25 search.
# BM25_TOP_K=20
# Number of unique documents kept after Reciprocal Rank Fusion merges both result sets.
# HYBRID_TOP_K=10
# HuggingFace model ID for cross-encoder reranking of fused results.
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Device for reranker inference: "cpu", "cuda", or "mps".
# RERANK_DEVICE=cpu
# How many top candidates the reranker scores before the pruning step.
# RERANK_TOP_K=5
# MMR diversity weight (0.0 = relevance only, 1.0 = diversity only).
# MMR_LAMBDA=0.7

# ── Storage ──────────────────────────────────────────────────────────────
# Where uploaded files (PDF, MD, TXT) and suggestions are stored
# DATA_DIR=./data
# Where the LanceDB vector index is persisted
# INDEX_DIR=./index

# ── PostgreSQL ───────────────────────────────────────────────────────────
# PostgreSQL connection string (async psycopg). Host defaults to "localhost" for local dev;
# use the Docker service name (e.g. "postgres") when running inside Docker Compose.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agroecology_ai
# Minimum number of idle connections kept warm in the shared async pool.
# DB_POOL_MIN_SIZE=2
# Maximum number of connections the shared async pool may grow to.
# DB_POOL_MAX_SIZE=15

# ── Cache — Valkey/Redis (optional) ──────────────────────────────────────
# Redis-compatible URL. If unreachable, caching is silently disabled.
# VALKEY_URL=redis://localhost:6379/0
# Seconds before a cached ask result expires and is recomputed.
# CACHE_TTL=3600

# ── Document Processing ──────────────────────────────────────────────────
# Extract title/authors from PDFs automatically via LLM after upload/approval
# AUTO_EXTRACT_METADATA=true

# ── Authentication ───────────────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens. Generate a strong random value.
# JWT_SECRET=change-me-in-production
# Access token lifetime in seconds (default 15 minutes).
# JWT_TTL_SECONDS=900
# Refresh token lifetime in days.
# REFRESH_TOKEN_TTL_DAYS=7
# Pepper value added to passwords before hashing to protect against rainbow tables.
# PASSWORD_PEPPER=agroecology-pepper
# Max conversation turns sent to the LLM as history context.
# MAX_HISTORY_TURNS=10
# Per-message character cap applied to preserved conversation history.
# MAX_HISTORY_MESSAGE_CHARS=1000
# Total character budget shared by preserved conversation history.
# MAX_HISTORY_TOTAL_CHARS=4000

# Admin account created by `python src/seed.py`
# ADMIN_EMAIL=admin@agroecologymap.org
# ADMIN_PASSWORD=admin123

# ── Email (SMTP) ─────────────────────────────────────────────────────────
# Used for: confirmation emails, password reset, suggestion notifications
# If not configured, emails are skipped (system still works, just silent)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=password
# SMTP_FROM=noreply@agroecologymap.org

# ── Application ───────────────────────────────────────────────────────────
# Frontend URL used in email links (confirmation, password reset, etc.)
# APP_URL=http://localhost:5173

# ── Job Worker ────────────────────────────────────────────────────────────
# How often the background worker checks for new jobs (seconds).
# WORKER_POLL_INTERVAL=10
# Max jobs dequeued per polling cycle.
# WORKER_BATCH_SIZE=5
# Max concurrent background worker threads.
# WORKER_MAX_WORKERS=1
# Grace period for workers to finish in-progress jobs before forced shutdown (seconds).
# WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
# Default max retry attempts for a job before it is marked as permanently failed.
# QUEUE_MAX_RETRIES_DEFAULT=3

# ── Task Management ──────────────────────────────────────────────────────
# How long an ask task result stays in memory before cleanup (seconds).
# TASK_TTL=3600
# How often the cleanup daemon runs to evict expired tasks (seconds).
# CLEANUP_INTERVAL=300
