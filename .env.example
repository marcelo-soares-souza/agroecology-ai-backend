# ── LLM ───────────────────────────────────────────────────────────────────
# Provider: any OpenAI-compatible API (Ollama, DeepSeek, vLLM, etc.)
# For Ollama (local): key is ignored by Ollama, use "ollama"
# For DeepSeek cloud: set your API key from https://api.deepseek.com
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
# Default local Ollama model for RAG. Pull it first: ollama pull qwen3:4b
# Sizing notes:
#   0.5B/1B: low memory and fast, but usually weak for RAG answers.
#   3B/4B: practical default for 6 GB VRAM GPUs.
#   7B/8B: may work on 6 GB VRAM, often slower or partly offloaded to RAM.
#   14B+: generally needs more VRAM/RAM; not recommended for small local GPUs.
LLM_MODEL=qwen3:4b

# To switch to DeepSeek cloud, comment the lines above and uncomment:
# LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash

# LLM generation parameters.
# Temperature: 0.0 = fully deterministic (recommended for RAG). Default: 0.0.
# LLM_TEMPERATURE=0.0

# Maximum tokens in the LLM response. Default: 4096.
# LLM_MAX_TOKENS=4096

# ── Embeddings ───────────────────────────────────────────────────────────
# Backend: "sentence_transformer" (local, default) or "ollama" (HTTP API).
# "sentence_transformer" loads the model from HuggingFace into RAM.
# "ollama" calls the Ollama /api/embed endpoint.
# EMBEDDING_BACKEND=sentence_transformer

# When EMBEDDING_BACKEND=sentence_transformer (default):
#   Any HuggingFace SentenceTransformer model. BAAI/bge-m3: 1024-dim, 102 languages.
# EMBEDDING_MODEL=BAAI/bge-m3

# Device for the embedding model: "cpu" (default), "cuda" (GPU).
# BGE-M3 uses ~2.2 GB on GPU. Recommended split for 6-8 GB VRAM:
#   embedder on GPU (most frequent use), reranker on CPU.
# For < 6 GB VRAM, keep both on CPU to avoid OOM.
# Falls back to CPU automatically if CUDA is not available.
# EMBEDDING_DEVICE=cpu

# Reduces CUDA memory fragmentation when GPU VRAM is limited.
# Recommended for GPUs with < 8 GB VRAM. No effect on CPU-only setups.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# When EMBEDDING_BACKEND=ollama:
#   Ollama server URL (default below).
#   OLLAMA_BASE_URL=http://localhost:11434
#   Embedding model name. Must be pulled first: ollama pull nomic-embed-text
#   OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Chunking ─────────────────────────────────────────────────────────────
# Tokens per chunk (100-2048). Higher = more context per chunk, slower retrieval.
CHUNK_SIZE=512

# Overlap between consecutive chunks in tokens (0-512).
# For scientific and technical texts, a higher overlap helps preserve context
# across paragraph and section boundaries.
CHUNK_OVERLAP=128

# ── Ingestion Batching ───────────────────────────────────────────────────
# Maximum documents per batch during ingestion. 0 or negative = single batch
# (current behaviour). Higher values consume more memory but may be faster.
# INGEST_BATCH_SIZE=0

# Maximum chunks per embedding sub-batch during ingestion. 0 or negative =
# single embedding call for the whole batch. Lower values reduce peak GPU VRAM
# during ingestion. 8 is safe for 6 GB VRAM; 32 is fine on CPU or 10+ GB VRAM.
# EMBEDDING_BATCH_SIZE=0

# ── Retrieval ────────────────────────────────────────────────────────────
# Vector search candidates retrieved before hybrid fusion.
# Higher values improve recall at the cost of more retrieval work.
SIMILARITY_TOP_K=20

# BM25 keyword search candidates for hybrid fusion (1-50).
BM25_TOP_K=20

# Number of RRF-fused candidates passed to the reranker (when enabled)
# or returned directly (when reranker is disabled).
# Keep this modest when the reranker runs on CPU. The cross-encoder reads every
# candidate jointly with the query, so 30 candidates can add tens of seconds.
HYBRID_TOP_K=10

# Cross-encoder model for reranking fused candidates.
# Set to empty to disable reranking (fallback to simple RRF fusion).
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Device for the reranker model: "cpu" (default), "cuda" (GPU).
# For 6 GB VRAM, keep the LLM on GPU and the reranker on CPU to avoid VRAM
# contention. Move the reranker to "cuda" only when you have enough free VRAM
# for the LLM, embedding model, reranker, and KV cache.
RERANK_DEVICE=cpu

# Final number of chunks sent to the LLM after cross-encoder reranking.
# Controls the context precision — fewer chunks = tighter, less noise.
RERANK_TOP_K=5

# Diversity vs relevance balance in MMR re-ranking (0.0-1.0).
# Higher values favor relevance (fewer sources, deeper context).
# Lower values favor diversity (more sources, broader coverage).
# Recommended: 0.7 for general use, 0.4 for broad synthesis, 0.9 for specific docs.
# MMR_LAMBDA=0.7

# ── Storage ──────────────────────────────────────────────────────────────
# Where uploaded files are stored (PDF, MD, TXT).
# DATA_DIR=./data

# Where the LanceDB vector index is persisted.
# INDEX_DIR=./index

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Database connection string (database, user, password, host, port).
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agroecology_ai

# ── Document Processing ──────────────────────────────────────────────────
# Automatically extract title and authors from the first page of uploaded
# PDFs using the LLM. Disable to skip the LLM call on every upload.
# Default: true
# AUTO_EXTRACT_METADATA=true

# ── Authentication ───────────────────────────────────────────────────────
# Secret key for JWT token signing. Change in production.
# JWT_SECRET=change-me-in-production

# Access token TTL in seconds. Default: 900 (15 min).
# JWT_TTL_SECONDS=900

# Refresh token TTL in days. Default: 7.
# REFRESH_TOKEN_TTL_DAYS=7

# Pepper prepended to passwords before bcrypt hashing. Change in production.
# PASSWORD_PEPPER=agroecology-pepper

# How many conversation turns (Q&A pairs) to keep as context. Default: 10.
# MAX_HISTORY_TURNS=10

# Admin user created by db:seed command.
# ADMIN_EMAIL=admin@agroecologymap.org
# ADMIN_PASSWORD=admin123

# ── Email (SMTP) ─────────────────────────────────────────────────────────
# SMTP server for sending confirmation and password reset emails.
# If not configured, emails are not sent but the system still works.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=password
# SMTP_FROM=noreply@agroecologymap.org

# ── Application ───────────────────────────────────────────────────────────
# Frontend URL used in email links (confirmation, password reset).
# APP_URL=http://localhost:5173

# ── Cache — Valkey/Redis (optional) ──────────────────────────────────────
# Connection URL. If set and unreachable, cache is silently disabled.
# Example: redis://localhost:6379/0
# VALKEY_URL=redis://localhost:6379/0

# Cache TTL in seconds. Identical questions within this window return cached
# answers without calling the LLM. Default: 3600 (1 hour).
# CACHE_TTL=3600

# ── Task Management ──────────────────────────────────────────────────────
# How long in-memory async tasks live before expiry. Default: 3600 (1 hour).
# TASK_TTL=3600

# How often the cleanup daemon removes expired tasks. Default: 300 (5 min).
# CLEANUP_INTERVAL=300

# ── Job Worker ────────────────────────────────────────────────────────────
# Seconds between worker polling ticks. Default: 10.
# WORKER_POLL_INTERVAL=10

# Maximum jobs acquired per polling tick. Default: 5.
# WORKER_BATCH_SIZE=5

# Number of parallel worker threads per tick. 1 = sequential (default).
# Higher values may saturate DB connections or LLM rate limits.
# WORKER_MAX_WORKERS=1

# Maximum seconds to wait for the worker to stop during shutdown.
# Active jobs are marked failed/retryable if the worker exceeds this timeout.
# WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# Default max_retries applied to new jobs at enqueue time.
# QUEUE_MAX_RETRIES_DEFAULT=3
