meta {
  name: Ask a question
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/ask
  body: json
  auth: none
}

body:json {
  {
    "question": "O que são sistemas agroflorestais?",
    "top_k": 5
  }
}

vars:pre-request {
  base_url: http://localhost:8000
}

script:post-response {
  const body = res.getBody();
  const json = JSON.parse(body);

  bru.setVar("task_id", json.task_id);
  console.log(`task_id: ${json.task_id}  status: ${json.status}`);
}
