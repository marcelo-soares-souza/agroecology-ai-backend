# Agroecology Map AI backend environment example.
# Copy this file to .env and uncomment only the values you want to override.

# LLM provider API key. Use "ollama" for local Ollama; use a real key for cloud providers.
# LLM_API_KEY=ollama
# LLM provider base URL. Ollama uses /v1 here; llama.cpp and DeepSeek also expose OpenAI-compatible /v1 endpoints.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM model name requested by the backend.
# LLM_MODEL=qwen3:4b
# Enables non-Ollama OpenAI-compatible providers such as DeepSeek or llama.cpp server.
# EXTERNAL_AI_ENABLED=false
# Comma-separated hostnames that should use Ollama's native /api/chat transport instead of /v1/chat/completions.
# OLLAMA_LLM_HOSTS=localhost,127.0.0.1,ollama,agroecology-ollama,agroecology-ai-ollama
# Response randomness. 0.0 is deterministic; higher values make responses more varied.
# LLM_TEMPERATURE=0.0
# Maximum tokens requested from the LLM API for a response.
# LLM_MAX_TOKENS=4096
# Context window size in tokens for local models that honor num_ctx.
# LLM_CONTEXT_LENGTH=8192
# Enables model "thinking" tokens for models that support them.
# LLM_THINK_ENABLE=true
# Hard cap for generated answer tokens, leaving room for retrieved context and history.
# LLM_COMPLETION_MAX_TOKENS=768
# Baseline number of retrieved chunks sent to the answer prompt.
# LLM_CONTEXT_MAX_CHUNKS=4
# Number of chunks used on retry when the first answer is empty.
# LLM_CONTEXT_RETRY_MAX_CHUNKS=2
# Maximum characters allowed per retrieved chunk before prompt assembly.
# LLM_CHUNK_MAX_CHARS=1300
# Total character budget shared by all retrieved chunks in the final prompt.
# LLM_CONTEXT_CHARS_BUDGET=9000

# Embedding backend. Use "sentence_transformer" locally or "ollama" for Ollama HTTP embeddings.
# EMBEDDING_BACKEND=sentence_transformer
# HuggingFace model ID used when EMBEDDING_BACKEND=sentence_transformer.
# EMBEDDING_MODEL=BAAI/bge-m3
# Device used by local embedding inference: cpu, cuda, or mps.
# EMBEDDING_DEVICE=cpu
# Ollama base URL used only when EMBEDDING_BACKEND=ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# Ollama embedding model used only when EMBEDDING_BACKEND=ollama.
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional PyTorch CUDA allocator tuning for GPUs with limited VRAM.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Tokens per logical chunk before indexing.
# CHUNK_SIZE=512
# Token overlap between adjacent logical chunks.
# CHUNK_OVERLAP=128
# Hard character cap for every indexed chunk.
# CHUNK_MAX_CHARS=1200
# Character overlap used when physically splitting long chunks.
# CHUNK_OVERLAP_CHARS=180
# Documents processed per ingestion batch. 0 means all documents at once.
# INGEST_BATCH_SIZE=0
# Chunks embedded per batch. 0 means auto-detect.
# EMBEDDING_BATCH_SIZE=0

# Runs OCR (RapidOCR) on PDF pages without a text layer, e.g. scanned documents.
# The engine is initialized lazily, only when a scanned page is detected.
# OCR_ENABLED=true
# Rendering resolution in DPI used before OCR. Higher values improve accuracy
# on small text at the cost of speed and memory.
# OCR_DPI=200
# Worker threads used for concurrent page OCR. 0 means auto (one per CPU core,
# capped at 8). Each worker keeps its own engine instance in memory.
# OCR_MAX_WORKERS=0

# Vector search candidate count before fusion.
# SIMILARITY_TOP_K=80
# BM25 keyword search candidate count before fusion.
# BM25_TOP_K=80
# Number of fused candidates retained after vector + BM25 Reciprocal Rank Fusion.
# HYBRID_TOP_K=25
# Internal result count requested by the answer pipeline.
# RAG_RETRIEVAL_TOP_K=12
# Optional cross-encoder reranker model. Empty disables reranking.
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Device used by the reranker: cpu, cuda, or mps.
# RERANK_DEVICE=cpu
# Number of top candidates kept after reranking.
# RERANK_TOP_K=12
# MMR diversity weight. 0.0 is relevance-only; 1.0 is diversity-only.
# MMR_LAMBDA=0.7

# Directory used for uploaded files, suggestions, and profile avatars.
# DATA_DIR=./data
# Directory used for the LanceDB vector index.
# INDEX_DIR=./index

# PostgreSQL connection string used by the async psycopg pool.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agroecology_ai
# Minimum number of idle PostgreSQL connections kept in the pool.
# DB_POOL_MIN_SIZE=2
# Maximum number of PostgreSQL connections in the pool.
# DB_POOL_MAX_SIZE=15

# Redis-compatible Valkey/Redis URL. If unreachable, cache is disabled silently.
# VALKEY_URL=redis://localhost:6379/0
# Answer cache TTL in seconds.
# CACHE_TTL=3600

# Automatically extract title/authors from PDFs after upload or suggestion approval.
# AUTO_EXTRACT_METADATA=true
# Automatically run academic metadata enrichment after title/authors extraction succeeds.
# AUTO_EXTRACT_ACADEMIC_METADATA=true
# Minimum delay in seconds between external academic metadata lookups.
# ACADEMIC_METADATA_MIN_DELAY_SECONDS=60
# Default delay in seconds used by metadata extraction jobs.
# ACADEMIC_METADATA_DEFAULT_DELAY_SECONDS=60
# Minimum confidence required before saving title/year/DOI metadata.
# ACADEMIC_METADATA_MIN_CONFIDENCE=0.88
# Minimum author-name confidence required before saving author metadata.
# ACADEMIC_METADATA_MIN_AUTHOR_CONFIDENCE=0.80
# Number of metadata candidates requested from each provider per document.
# ACADEMIC_METADATA_CANDIDATES_PER_PROVIDER=5
# Contact email sent to OpenAlex requests.
# OPENALEX_MAILTO=contact@example.org
# Contact email sent to Crossref requests.
# CROSSREF_MAILTO=contact@example.org
# Optional OpenAlex API key.
# OPENALEX_API_KEY=
# Optional Semantic Scholar API key used by backend/scripts/lookup_academic_metadata.py.
# SEMANTIC_SCHOLAR_API_KEY=
# Optional alias for SEMANTIC_SCHOLAR_API_KEY used by the same metadata lookup script.
# S2_API_KEY=

# Secret used to sign and verify JWT access tokens.
# JWT_SECRET=change-me-in-production
# Access token lifetime in seconds.
# JWT_TTL_SECONDS=900
# Refresh token lifetime in days.
# REFRESH_TOKEN_TTL_DAYS=30
# Grace window in seconds for duplicate refresh requests after token rotation.
# REFRESH_TOKEN_REUSE_GRACE_SECONDS=60
# Secret pepper appended before password hashing.
# PASSWORD_PEPPER=agroecology-pepper
# Failed sign-in/sign-up attempts allowed before blocking an email/IP pair.
# AUTH_RATE_LIMIT_MAX_FAILURES=5
# Block duration in seconds after the auth rate limit is exceeded.
# AUTH_RATE_LIMIT_BLOCK_SECONDS=600
# Enables the AI chat and its conversation endpoints. Set to false to keep the
# document database available while the chat infrastructure is paused.
# CHAT_ENABLED=true
# Optional external Agroecology Map identity server URL. Empty disables this integration.
# IDENTITY_SERVER_URL=
# Enables automatic local account provisioning from the external identity server.
# IDENTITY_SERVER_AUTO_PROVISIONING_ENABLED=false
# Enables Sign in with ORCID in the backend and frontend provider list.
# ORCID_ENABLED=false
# ORCID environment used for default OAuth URLs: sandbox or production.
# ORCID_ENV=sandbox
# ORCID OAuth client ID issued by ORCID.
# ORCID_CLIENT_ID=
# ORCID OAuth client secret issued by ORCID. Keep this value only on the backend.
# ORCID_CLIENT_SECRET=
# Public backend callback URL registered in ORCID. Local example: http://localhost:8000/api/v1/auth/orcid/callback
# ORCID_REDIRECT_URI=
# ORCID authorization endpoint. Leave empty unless using a custom ORCID-compatible server.
# ORCID_AUTHORIZE_URL=https://sandbox.orcid.org/oauth/authorize
# ORCID token endpoint. Leave empty unless using a custom ORCID-compatible server.
# ORCID_TOKEN_URL=https://sandbox.orcid.org/oauth/token
# ORCID OpenID userinfo endpoint. Leave empty unless using a custom ORCID-compatible server.
# ORCID_USERINFO_URL=https://sandbox.orcid.org/oauth/userinfo
# Minutes allowed to complete email entry, account linking, or token exchange after ORCID returns.
# ORCID_COMPLETION_TTL_MINUTES=30
# Current privacy policy version stored on user acceptance.
# PRIVACY_POLICY_VERSION=2026-06-25
# Current terms of service version stored on user acceptance.
# TOS_VERSION=2026-06-25
# Comma-separated proxy hosts trusted by Uvicorn ProxyHeadersMiddleware.
# TRUSTED_PROXY_HOSTS=127.0.0.1,::1,localhost
# Maximum active saved chat conversations allowed per user.
# CHAT_MAX_CONVERSATIONS_PER_USER=10
# Max conversation turns sent back to the LLM as history context.
# MAX_HISTORY_TURNS=10
# Per-message character cap applied to preserved conversation history.
# MAX_HISTORY_MESSAGE_CHARS=1000
# Total character budget shared by preserved conversation history.
# MAX_HISTORY_TOTAL_CHARS=4000

# Admin email used by python main.py db:seed.
# ADMIN_EMAIL=admin@agroecologymap.org
# Admin password used by python main.py db:seed.
# ADMIN_PASSWORD=admin123
# Mobile reviewer email used by python main.py db:mobile.
# MOBILE_EMAIL=mobile@agroecologymap.org
# Mobile reviewer password used by python main.py db:mobile.
# MOBILE_PASSWORD=mobile123
# Mobile reviewer display name used by python main.py db:mobile.
# MOBILE_FULL_NAME=Mobile User
# Mobile reviewer public slug used by python main.py db:mobile.
# MOBILE_SLUG=mobile-user
# Mobile reviewer locale used by python main.py db:mobile.
# MOBILE_LOCALE=en

# SMTP hostname used for confirmation, reset, deletion, and notification emails.
# SMTP_HOST=smtp.example.com
# SMTP port used for SMTP submission.
# SMTP_PORT=587
# SMTP username.
# SMTP_USER=user@example.com
# SMTP password.
# SMTP_PASSWORD=password
# Sender address used in outgoing emails.
# SMTP_FROM=noreply@agroecologymap.org

# Public frontend URL used to build email confirmation, reset, and deletion links.
# APP_URL=http://localhost:5173

# Background worker polling interval in seconds.
# WORKER_POLL_INTERVAL=10
# Maximum jobs dequeued per polling cycle.
# WORKER_BATCH_SIZE=5
# Maximum concurrent worker threads.
# WORKER_MAX_WORKERS=1
# Grace period in seconds before worker shutdown is forced.
# WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
# Default retry count for jobs before permanent failure.
# QUEUE_MAX_RETRIES_DEFAULT=3

# Ask task result TTL in seconds.
# TASK_TTL=3600
# Expired task cleanup interval in seconds.
# CLEANUP_INTERVAL=300
